# II-Researcher Environment Configuration Template
# Copy this file to .env and fill in your API keys

# ============================================================================
# REQUIRED: LLM Configuration
# ============================================================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=http://localhost:4000

# ============================================================================
# REQUIRED: Search Provider Configuration
# Choose one search provider and set its API key
# ============================================================================

# Option 1: SerpAPI (Recommended - Google search results)
SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=your-serpapi-key-here

# Option 2: Tavily (AI-powered search)
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=your-tavily-key-here

# Option 3: DuckDuckGo (Free - no API key required)
# SEARCH_PROVIDER=duckduckgo
# No API key needed for DuckDuckGo

# ============================================================================
# REQUIRED: Scraper Provider Configuration
# Choose one scraper provider and set its API key if needed
# ============================================================================

# Option 1: Firecrawl (Recommended - premium scraping)
SCRAPER_PROVIDER=firecrawl
FIRECRAWL_API_KEY=your-firecrawl-key-here

# Option 2: BeautifulSoup (Free - basic scraping)
# SCRAPER_PROVIDER=bs
# No API key needed

# Option 3: Browser-based scraping
# SCRAPER_PROVIDER=browser
# No API key needed

# Option 4: Tavily Extract
# SCRAPER_PROVIDER=tavily_extract
# TAVILY_API_KEY=your-tavily-key-here

# ============================================================================
# OPTIONAL: LLM Model Configuration
# ============================================================================

# Models for Pipeline Mode
STRATEGIC_LLM=gpt-4o
SMART_LLM=gpt-4o
FAST_LLM=gemini-lite

# Models for Reasoning Mode
R_MODEL=r1
R_TEMPERATURE=0.2
R_REPORT_MODEL=gpt-4o
R_PRESENCE_PENALTY=0

# ============================================================================
# OPTIONAL: Compression Configuration
# ============================================================================
COMPRESS_EMBEDDING_MODEL=text-embedding-3-large
COMPRESS_SIMILARITY_THRESHOLD=0.3
COMPRESS_MAX_OUTPUT_WORDS=4096
COMPRESS_MAX_INPUT_WORDS=32000
USE_LLM_COMPRESSOR=false

# ============================================================================
# OPTIONAL: Timeout and Performance Settings
# ============================================================================
SEARCH_PROCESS_TIMEOUT=300
SEARCH_QUERY_TIMEOUT=20
SCRAPE_URL_TIMEOUT=30
STEP_SLEEP=100

# ============================================================================
# OPTIONAL: DeepSeek Configuration (if using DeepSeek R1)
# ============================================================================
# DEEPSEEK_API_KEY=your-deepseek-key-here

# ============================================================================
# OPTIONAL: Container-Specific Configuration
# ============================================================================
# SERVICE_MODE=all  # Options: all, litellm, api, frontend, mcp, api+litellm, frontend+api, cli, supervisor
# MCP_TRANSPORT=stdio  # Options: stdio, http
# MCP_PORT=8765
# RESEARCH_QUESTION="Your question here"  # For CLI mode

# ============================================================================
# Notes:
# ============================================================================
# 1. Required keys depend on your provider choices
# 2. Free option: Use SEARCH_PROVIDER=duckduckgo and SCRAPER_PROVIDER=bs
# 3. For production, consider using Tavily or SerpAPI for better results
# 4. Container defaults to running all services (frontend, api, litellm)
# 5. See DOCKER.md for detailed configuration options
