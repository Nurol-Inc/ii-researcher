# ============================================================================
# Version Arguments
# ============================================================================
ARG PYTHON_VERSION=3.12.12
ARG DEBIAN_VERSION=bookworm

FROM python:${PYTHON_VERSION}-slim-${DEBIAN_VERSION} AS base

WORKDIR /app

COPY pyproject.toml .
COPY ii_researcher/ ./ii_researcher/
RUN pip install --no-cache-dir .

COPY . .

EXPOSE 8000
